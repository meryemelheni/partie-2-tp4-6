Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.define "vm1" do |vm1|
    vm1.vm.hostname = "vm1"
    vm1.vm.network "private_network", ip: "192.168.56.11"
    vm1.vm.network "forwarded_port", guest: 8080, host: 8090, host_ip: "0.0.0.0"
    vm1.vm.network "forwarded_port", guest: 9000, host: 9090, host_ip: "0.0.0.0"
    vm1.vm.network "forwarded_port", guest: 80, host: 8092, host_ip: "0.0.0.0"
    vm1.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end
    vm1.vm.provision "ansible" do |ansible|
      ansible.playbook = "playbook.yml"
    end
  end

  config.vm.define "vm2" do |vm2|
    vm2.vm.hostname = "vm2"
    vm2.vm.network "private_network", ip: "192.168.56.12"
    vm2.vm.network "forwarded_port", guest: 8080, host: 8091, host_ip: "0.0.0.0"
    vm2.vm.network "forwarded_port", guest: 9000, host: 9091, host_ip: "0.0.0.0"
    vm2.vm.network "forwarded_port", guest: 80, host: 8093, host_ip: "0.0.0.0"
    vm2.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end
    vm2.vm.provision "ansible" do |ansible|
      ansible.playbook = "playbook.yml"
    end
  end
end
