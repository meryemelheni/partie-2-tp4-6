Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.define "cv-vm1" do |vm1|
    vm1.vm.hostname = "cv-vm1"
    vm1.vm.network "private_network", ip: "192.168.56.21"
    vm1.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end
    vm1.vm.provision "ansible" do |ansible|
      ansible.playbook = "playbook.yml"
    end
  end

  config.vm.define "cv-vm2" do |vm2|
    vm2.vm.hostname = "cv-vm2"
    vm2.vm.network "private_network", ip: "192.168.56.22"
    vm2.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end
    vm2.vm.provision "ansible" do |ansible|
      ansible.playbook = "playbook.yml"
    end
  end
end
